        <mxCell id="W5tNANtO_O0zJ1GNnltF-44" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dff1d7;strokeColor=#0b7a20;strokeWidth=2;fontSize=16;" value="&lt;b&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;Environmental Risk Scoring&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;Model:&lt;/b&gt; SafeDriver-IQ Random Forest&amp;nbsp;bridge or metadata fallback&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;div style=&quot;font-size: 16px;&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Input: &lt;/span&gt;weather, lighting, road condition&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Environmental Risk Score in [0,1]&lt;/font&gt;&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="109" width="360" x="469.77" y="131" as="geometry" />
        </mxCell>
        <mxCell id="W5tNANtO_O0zJ1GNnltF-45" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff2cc;strokeColor=#d79b00;strokeWidth=2;fontSize=15;" value="&lt;b&gt;&lt;font style=&quot;font-size:17px&quot;&gt;Trajectory Kinematic Analysis&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;Model:&lt;/b&gt; LSTM&lt;br&gt;&lt;b&gt;Input features:&lt;/b&gt; position, heading,&amp;nbsp;&lt;div&gt;velocity at 10Hz&lt;br&gt;&lt;b&gt;Derived:&lt;/b&gt; Time-to-Collision (TTC),&amp;nbsp;&lt;/div&gt;&lt;div&gt;closing risk&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; Trajectory Risk Signal&lt;/div&gt;" vertex="1">
          <mxGeometry height="155" width="299.77" x="530" y="280" as="geometry" />
        </mxCell>
        <mxCell id="W5tNANtO_O0zJ1GNnltF-46" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fce5cd;strokeColor=#e36c0a;strokeWidth=2;fontSize=15;" value="&lt;b&gt;&lt;font style=&quot;font-size:17px&quot;&gt;VRU Interaction Prediction&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;Model:&lt;/b&gt; Social Force Model + LSTM Hybrid&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; pedestrian and cyclist tracks&lt;br&gt;&lt;b&gt;Features:&lt;/b&gt;&amp;nbsp;minimum distance, relative velocity, TTC, encroachment risk&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; VRU Interaction Risk Score" vertex="1">
